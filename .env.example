# رابط قاعدة بيانات PostgreSQL (Railway يضيفه تلقائياً عند ربط قاعدة البيانات)
DATABASE_URL=postgres://user:password@localhost:5432/marmouq

# مفتاح سري لتوقيع جلسات لوحة التحكم (32 حرفاً عشوائياً أو أكثر)
AUTH_SECRET=change-me-to-a-long-random-string

# حساب المالك الأول للوحة التحكم (يُنشأ تلقائياً عند أول تشغيل)
ADMIN_EMAIL=owner@marmouq.store
ADMIN_PASSWORD=change-this-password

# رابط المتجر العام (لخريطة الموقع وروابط المشاركة)
NEXT_PUBLIC_SITE_URL=https://marmouq.up.railway.app

# اختياري: إشعار فوري بكل طلب جديد على تيليجرام
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
